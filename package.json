{
  "name": "modcraft-studio",
  "version": "0.2.0",
  "description": "ModCraft Studio - Minecraft Java texture and model workspace",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pl.modcraftstudio.app",
    "productName": "ModCraft Studio",
    "directories": { "output": "release" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}